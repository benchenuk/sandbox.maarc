Screen {
    layout: vertical;
    background: $surface;
}

/* Header - large title */
HeaderWidget {
    height: 2;
    content-align: center middle;
    background: $surface-darken-1;
}

HeaderWidget .title-main {
    text-style: bold;
    color: $text;
    text-align: center;
}

HeaderWidget .title-sub {
    color: $text-muted;
    text-align: center;
}

.main-container {
    padding: 0 1;
}

/* Workflow - single row with arrows left, status right */
WorkflowWidget {
    height: 1;
    margin: 1 0 1 0;
}

.workflow-row {
    height: 1;
    width: 100%;
}

.arrows-container {
    height: 1;
    width: auto;
}

.phase-arrow {
    width: auto;
    height: 1;
    padding: 0 1;
    content-align: center middle;
    color: $text-muted;
}

.phase-arrow.active {
    background: $success;
    color: $text;
    text-style: bold;
}

.phase-arrow.completed {
    background: $success-darken-2;
    color: $text;
}

/* Arrow separator between phases */
.arrow-separator {
    color: $text-muted;
    width: auto;
    padding: 0;
}

.status-container {
    height: 1;
    width: auto;
    align: right middle;
    margin-left: 4;
}

.label {
    color: $text-muted;
}

.separator {
    color: $text-muted;
}

#iteration-count {
    color: $text;
}

#elapsed-time {
    color: $text;
}

/* Agent Team - list view with legend */
AgentTeamWidget {
    height: auto;
    max-height: 10;
    margin: 0 0 1 0;
    padding: 0;
}

.legend-row {
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

.legend-item {
    margin-right: 2;
}

#agent-list {
    height: auto;
}

.agent-card {
    height: 1;
    margin: 0 0 0 0;
    content-align: left middle;
}

/* Log - maximize space, minimal scrollbars */
LogWidget {
    height: 1fr;
    border: none;
    padding: 0 1;
    scrollbar-size: 1 1;
    scrollbar-background: $surface;
    scrollbar-color: $surface $surface;
}

LogWidget:hover {
    scrollbar-color: $surface-lighten-2 $surface-lighten-2;
}

/* Input - minimal */
InputWidget {
    height: 1;
    margin: 1 0 0 0;
}

.input-row {
    height: 1;
}

.prompt {
    color: $text-muted;
    width: 2;
}

#input-line {
    height: 1;
    border: none;
    background: $surface;
    padding: 0;
}

#input-line:focus {
    border: none;
}

/* Footer - minimal */
Footer {
    height: 1;
    background: $surface-darken-1;
}

Footer > .footer--key {
    color: $text-muted;
    background: $surface-darken-1;
    text-style: none;
}

Footer > .footer--highlight {
    color: $text;
    background: $surface-darken-1;
    text-style: bold;
}
