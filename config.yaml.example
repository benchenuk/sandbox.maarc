# Consensus-CLI Configuration File
# Copy this file to config.yaml and customize for your setup
# DO NOT commit config.yaml if it contains API keys

app:
  name: Consensus-CLI
  version: 0.2.0

research:
  # Iteration settings
  # default_iterations: Number of debate cycles to run
  # min_iterations: Minimum cycles before allowing early exit
  # max_iterations: Hard limit to prevent infinite loops
  default_iterations: 5
  min_iterations: 3
  max_iterations: 10
  consensus_threshold: 0.85
  stability_threshold: 0.9

# ============================================================================
# Orchestrator Configuration (The "Brain")
# ============================================================================
# The Orchestrator is the central controller that:
# - Analyzes topics and generates expert teams
# - Evaluates agent outputs and detects conflicts
# - Routes information between agents
# - Decides when consensus is reached
# 
# The orchestrator uses a provider from the models.providers pool.

orchestrator:
  # Which provider to use (must match a key in models.providers)
  provider: litellm_proxy
  temperature: 0.7
  
  # Reasoning capabilities (future feature)
  # enable_chain_of_thought: true
  # enable_self_critique: true
  
  # Team generation settings
  team_generation:
    min_agents: 3
    max_agents: 5
    require_skeptic: true  # Always include a critic/skeptic role
    
  # Conflict detection settings (future feature)
  conflict_detection:
    enabled: false  # Future: enable LLM-based conflict analysis
    sensitivity: "medium"  # low, medium, high

# ============================================================================
# Model Provider Configuration
# ============================================================================
# The system supports multiple LLM providers through a provider pool.
# Each provider is a complete tuple of (name, url, api_key, model).
# Future iterations will implement routing strategies.

models:
  # --------------------------------------------------------------------------
  # Provider Pool - Define all available LLM endpoints
  # Each provider is a self-contained configuration with its own model
  # --------------------------------------------------------------------------
  providers:
    # Option 1: LiteLLM Proxy (unified endpoint for multiple backends)
    litellm_proxy:
      enabled: true
      api_base: "http://localhost:4000"
      api_key: ""  # Set via env var or use ${ENV_VAR} syntax
      default_model: "gpt-4o"
      
    # Option 2: Direct OpenAI
    openai:
      enabled: false
      api_base: "https://api.openai.com/v1"
      api_key: ""  # Set via OPENAI_API_KEY env var or ${OPENAI_API_KEY}
      default_model: "gpt-4o"
      
    # Option 3: Local/Ollama
    ollama:
      enabled: false
      api_base: "http://localhost:11434/v1"
      api_key: "ollama"  # Ollama doesn't require a real key
      default_model: "llama3"
      
    # Option 4: OpenRouter
    openrouter:
      enabled: false
      api_base: "https://openrouter.ai/api/v1"
      api_key: ""  # Set via OPENROUTER_API_KEY env var or ${OPENROUTER_API_KEY}
      default_model: "openai/gpt-4o"

  # --------------------------------------------------------------------------
  # Routing Strategy (Future Feature)
  # How to select from multiple providers:
  #   - "single": Use the provider specified per-component (current implementation)
  #   - "round_robin": Rotate through enabled providers
  #   - "specialty": Route based on agent role
  #   - "cost_optimized": Select cheapest provider
  #   - "performance": Select fastest/lowest-latency provider
  # --------------------------------------------------------------------------
  routing_strategy: "single"
  
  # --------------------------------------------------------------------------
  # Spawning Agents Configuration
  # --------------------------------------------------------------------------
  # The Orchestrator generates domain-specific agents for each research topic.
  # This configures which provider spawned agents will use.
  # Future: Multiple agent pools for different types of agents
  # --------------------------------------------------------------------------
  agents:
    # Default provider for all spawned agents
    default:
      provider: litellm_proxy
      temperature: 0.7

# ============================================================================
# Output Configuration
# ============================================================================
output:
  format: markdown
  directory: reports
  include_raw_transcripts: false  # Set to true to include full agent outputs

# ============================================================================
# Human-in-the-Loop Configuration
# ============================================================================
human_in_the_loop:
  enabled: true
  checkpoint_frequency: every_cycle  # Options: every_cycle, end_only, manual
  pause_on_conflicts: true  # Pause when agents disagree significantly

# ============================================================================
# CLI Display Settings
# ============================================================================
ui:
  show_spinner: true
  color_enabled: true
  verbose: false  # Set to true for detailed API call logging

# ============================================================================
# Example Configurations
# ============================================================================

